<resources>
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <item name="android:statusBarColor">@color/app_background</item>
        <item name="android:navigationBarColor">@color/app_background</item>
        <item name="android:windowBackground">@color/app_background</item>
        <item name="android:windowLightNavigationBar">@bool/light_system_bars</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:colorAccent">#218ec5</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
</resources>
